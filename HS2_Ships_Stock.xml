			<ArmorLimits massClass="light"			speedAdj="-1" />
		</Hull>

		<Drive
			maxSpeed=			"9"
			thrust=				"5000"
			/>

		<Maneuver
			maxRotationRate=	"1.0"
			rotationAccel=		"0.5"
			/>

		<DeviceSlots>
			<DeviceSlot id="main"			criteria="w" posAngle="0" posRadius="57" posZ="0"/>
			<DeviceSlot id="turret"			criteria="w~l" posAngle="0" posRadius="0" posZ="40"	fireAngle="0" omnidirectional="true">
				<EnhancementAbilities>
					<!-- To determine the balance for slots that make
					non-omni weapons omni/swivel, use the following formula:

					100 + 100 * (Arc/360)^0.5

					speed is a % multiplier to fire rate delay, so values > 100 are debuffs
					-->
					<Enhance type=			"&HS2_vtTurretSlotWithNonOmni;"
							 enhancement=	"-speed:200;"
							 criteria=		"w -property:omnidirectional;"
							 />
				</EnhancementAbilities>
			</DeviceSlot>

			<DeviceSlot id="cargo"			criteria="c" cannotBeEmpty="true"/>
			<DeviceSlot id="shipSystems"		criteria="dV +shipSystems"	cannotBeEmpty="true"/>
		</DeviceSlots>

		<Interior>
			<Compartment name="interior"
					hitPoints=	"30"
					/>
		</Interior>

		<!-- Configuration -->
		
		<Armor
			armorID=			"&itUltraLightTitaniumArmor;"
			count=				"8"
			/>
		
		<Devices>
			<Device	slotID="turret"			deviceID="&itLightRecoillessCannon;"/>
			<Device slotID="cargo"			deviceID="&itCargoHoldExpansion;"/>

			<Device slotID="shipSystems"		deviceID="&vtShipSystems100;"/>
		</Devices>

		<Items>
		</Items>

		<!-- Image and Effects -->
		
		<Image imageID="&HS2_rsMakayevVoskhodI;" imageWidth="116" imageHeight="116"	rotationCount="360" rotationColumns="20" viewportRatio="0.2"/>
		<HeroImage imageID="&HS2_rsMakayevVoskhodIHero;" imageWidth="320" imageHeight="320"/>

		<Effects>
			<Effect type="thrustMain"               posAngle="156"  posRadius="59"  posZ="0"        rotation="180"  effect="&efMainThrusterLarge;"/>
			<Effect type="thrustMain"               posAngle="-156" posRadius="59"  posZ="0"        rotation="180"  effect="&efMainThrusterLarge;"/>
			<Effect type="thrustMain"               posAngle="-179" posRadius="53"  posZ="26"       rotation="180"  effect="&efMainThrusterLarge;"/>
			<Effect type="thrustMain"               posAngle="-179" posRadius="53"  posZ="-26"      rotation="180"  effect="&efMainThrusterLarge;"/>
		</Effects>
		
		<!-- AI and Behavior -->

		<AISettings
			perception=			"4"
			combatStyle=		"standOff"
			/>
		
		<!-- Text -->
		
		<Language>
			<Text id="core.descLore">
				The Voskhod I was one of the first heavy freighters introduced
				with a fusion power plant. With its massive engines, designed
				to propel twice as much cargo on the Voskhod II which launched
				alongside the Voskhod I, it was fast for its day, though in
				modern times it can barely outpace even the aging Antares I.

				It retains some popularity purely because the ships and
				replacement parts are cheap
			</Text>
			<Text id="core.desc">
				The Voskhod I is an old, barebones heavy freighter. While its faster
				than its larger siblings, this is a very old and dated hull with
				limited expansion capabilities.
			</Text>
		</Language>
	</ShipClass>
	
