	<!-- Level 1: Voskhod I Freighter -->

	<ShipClass UNID="&HS2_scMakayevVoskhodIKorolov;"
			manufacturer=		"Makayev-Energia"
			class=				"Voskhod I"
			type=				"freighter"
			inherit=			"&HS2_scMakayevVoskhodI;"
			defaultSovereign=	"&svCommonwealth;"

			attributes=			"commonwealth, freighter, genericClass, makayev"
			>
		
		<Devices>
			<Table>
				<Group chance="25">
					<Device slotID="turret"	deviceID="&itRecoillessCannon;"/>
				</Group>
				<Group chance="20">
					<Device slotID="turret"	deviceID="&itLightRecoillessCannon;"/>
					<Device item="&itArmorRepairDevice;"/>
				</Group>
				<Group chance="15">
					<Device slotID="turret"	deviceID="&itLaserCannon;"/>
				</Group>
				<Group chance="10">
					<Device slotID="turret"	deviceID="&itTridentCannon;"/>
				</Group>
				<Group chance="10">
					<Device slotID="turret"	deviceID="&itHeavyRecoillessCannon;"/>
				</Group>
				<Group chance="10">
					<Device slotID="turret"	deviceID="&itDartTurret;"/>
					<Device item="&itArmorRepairDevice;"/>
				</Group>
				<Group chance="10">
					<Device slotID="turret"	deviceID="&itAlpha1LaserTurret;"/>
					<Device item="&itArmorRepairDevice;"/>
				</Group>
			</Table>

			<Device slotID="cargo"			deviceID="&itCargoHoldExpansion;"/>

			<Table>
				<Device slotID="shipSystems"	chance="50" deviceID="&vtShipSystems200;"/>
				<Device slotID="shipSystems"	chance="15" deviceID="&vtShipSystems250;"/>
				<Device slotID="shipSystems"	chance="10" deviceID="&vtShipSystems125;"/>
				<Device slotID="shipSystems"	chance="25" deviceID="&vtShipSystems150;"/>
			</Table>
		</Devices>

		<Items>
		</Items>
		
		<!-- AI and Behavior -->

		<AISettings
			fireAccuracy=		"90"
			perception=			"4"
			combatStyle=		"standOff"
			/>
		<!-- Korolov -->

		<Names noArticle="true">Voskhod Heavy 1%0%0</Names>

		<Properties>

			<DynamicGlobal id="korolov.cargoValue.0">
				(korRandomCargoValue 10000 20000)
			</DynamicGlobal>

			<DynamicGlobal id="korolov.cargoValue.1">
				(korRandomCargoValue 15000 25000)
			</DynamicGlobal>

			<DynamicGlobal id="korolov.cargoValue.2">
				(korRandomCargoValue 20000 35000)
			</DynamicGlobal>

			<DynamicGlobal id="korolov.cargoValue.3">
				(korRandomCargoValue 30000 50000)
			</DynamicGlobal>

			<DynamicGlobal id="korolov.cargoValue.4">
				(korRandomCargoValue 35000 60000)
			</DynamicGlobal>

			<Global id="korolov.escortRate">
				350
			</Global>
		</Properties>
		
		<Events>
			<OnDestroy>
				(korOnShipDestroyed)
			</OnDestroy>
		</Events>
		
		<Language>
			<Text id="korolov.shipDesc">
				The Voskhod freighters are the pre-syrtis war ancestors to
				the Antares series. They are still often in operation because
				the hulls are cheap and they can still carry substantial
				amounts of basic goods. Unlike most heavy freighters,
				pirates almost never send frigates after these ships because
				most of their cargo has extremely low value.

				The Voskhod I flies well enough and attracts so little attention
				that even new pilots and apprentices are allowed to escort them.
			</Text>
		</Language>
	</ShipClass>
	
